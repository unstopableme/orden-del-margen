# Credential-free local demo against the in-memory API.
VITE_COMMUNITY_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:3000

# Passport mode only: set demo mode to false and configure the public client ID
# and redirect URIs registered with the Passport application.
# VITE_IMMUTABLE_PASSPORT_CLIENT_ID=replace-with-hub-client-id
# VITE_IMMUTABLE_REDIRECT_URI=http://localhost:8000/redirect
# VITE_IMMUTABLE_LOGOUT_URI=http://localhost:8000/logout
