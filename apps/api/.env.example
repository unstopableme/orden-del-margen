# Durable mode. Use a dedicated database and never commit credentials.
DATABASE_URL=postgres://user:password@localhost:5432/orden_del_margen
PG_POOL_MAX=10
PGSSL_MODE=verify-full
# PGSSL_CA_PATH=C:\path\to\provider-ca.pem
# PGSSL_CA_BASE64=base64-encoded-provider-ca
# PGSSL_SERVERNAME=database.provider.example

# Required only when running migration or seed commands.
DATABASE_PURPOSE=development
DATABASE_EXPECTED_NAME=orden_del_margen

# Production authentication: verify Immutable Passport ID tokens and resolve
# their subject through server-owned PostgreSQL wallet bindings.
# COMMUNITY_AUTH_MODE=immutable-passport
# IMMUTABLE_PASSPORT_CLIENT_ID=replace-with-passport-client-id
# IMMUTABLE_PASSPORT_ISSUER=https://provider-documented-issuer.example
# IMMUTABLE_PASSPORT_JWKS_URI=https://auth.immutable.com/.well-known/jwks.json

# Development bridge only: JSON object mapping opaque Bearer tokens to members.
COMMUNITY_AUTH_MODE=configured
COMMUNITY_SESSION_TOKENS={"replace-with-a-long-random-token":"member-1"}

# Local preview alternative only. Refused when NODE_ENV=production.
# COMMUNITY_DEMO_AUTH=true
# COMMUNITY_STORAGE=memory

ALLOWED_FRONTEND_ORIGINS=http://localhost:8000
TRUST_PROXY_CIDRS=127.0.0.1
AUTH_ATTEMPT_RATE_LIMIT=60
AUTH_ATTEMPT_RATE_WINDOW_MS=60000
AUTHENTICATED_RATE_LIMIT=120
AUTHENTICATED_RATE_WINDOW_MS=60000
REWARD_RATE_LIMIT=10
REWARD_RATE_WINDOW_MS=60000
PORT=3000
